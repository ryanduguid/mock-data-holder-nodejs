{
  "name": "test-data-server",
  "version": "1.3.0",
  "description": "An app to host test data generated",
  "main": "app.js",
  "scripts": {
    "prebuild": "rimraf ./dist",
    "start": "npm run build && cp ../.env ./dist/src && cd ./dist/src && node  ./app.js",
    "build": "tsc   && npm run copy-files",
    "build:docker": "tsc ",
    "copy-files": "copyfiles -f \"../security/mock-data-holder/tls/**/*\"  \"./dist/src/security/\"",
    "test": "node --test tests/*.test.cjs",
    "dev": "nodemon"
  },
  "keywords": [
    "nodejs",
    "typescript"
  ],
  "author": "Tomas Schier",
  "license": "MIT",
  "overrides": {
    "@cds-au/holder-sdk": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^4.17.13",
    "@types/node": "^18.13.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@cds-au/holder-sdk": "^2.2.0",
    "@types/body-parser": "^1.19.2",
    "@types/consumer-data-standards": "^7.3.0",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.18.2",
    "@types/mongoose": "^5.11.97",
    "@types/mongoose-paginate": "^5.0.16",
    "axios": "^1.4.0",
    "body-parser": "^1.20.3",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "jwt-decode": "^3.1.2",
    "moment": "^2.30.1",
    "mongodb": "^4.13.0",
    "mongoose": "^8.9.6",
    "mongoose-paginate-v2": "^1.8.0",
    "openid-client": "^5.4.3",
    "rimraf": "^6.0.1",
    "swagger-ui-express": "^5.0.0",
    "test-data-server": "file:",
    "typedi": "^0.10.0"
  }
}
